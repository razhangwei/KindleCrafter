# KindleCrafter Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SETTINGS STORE - Vercel Edge Config (Optional - enables saving Kindle email)
# =============================================================================
# Read connection string. Auto-injected when an Edge Config store is linked
# to the Vercel project (Storage > Edge Config > Connect to project).
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxx

# Edge Config store ID and a Vercel API token are required for writes
# (when the user updates their Kindle email via the Settings page).
# Create a token at: https://vercel.com/account/tokens
EDGE_CONFIG_ID=ecfg_xxxxxxxxxxxx
VERCEL_API_TOKEN=your-vercel-api-token

# Only set if the project lives under a Vercel team (not a personal account)
VERCEL_TEAM_ID=

# =============================================================================
# EMAIL SERVICE (Optional - enables "Send to Kindle" feature)
# =============================================================================
# Choose ONE of the following options:

# Option 1: Resend (Recommended)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxxxxx
SENDER_EMAIL=noreply@yourdomain.com

# Option 2: Gmail (Fallback)
# Use an App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# =============================================================================
# PODCAST TRANSCRIPTION (Optional - enables podcast feature)
# =============================================================================
# Gemini API for podcast transcription
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# BACKGROUND JOBS - Inngest (Required for podcast feature)
# =============================================================================
# Sign up at https://app.inngest.com and get your keys from the dashboard
# For local development, run: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key

# =============================================================================
# PASSWORD PROTECTION (Optional)
# =============================================================================
# Set this to require a password for access
# Leave empty or unset for public access
APP_PASSWORD=
