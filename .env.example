# KindleCrafter Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE (Optional - enables saving settings)
# =============================================================================
# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# EMAIL SERVICE (Optional - enables "Send to Kindle" feature)
# =============================================================================
# Choose ONE of the following options:

# Option 1: Resend (Recommended)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxxxxx
SENDER_EMAIL=noreply@yourdomain.com

# Option 2: Gmail (Fallback)
# Use an App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# =============================================================================
# PASSWORD PROTECTION (Optional)
# =============================================================================
# Set this to require a password for access
# Leave empty or unset for public access
APP_PASSWORD=
